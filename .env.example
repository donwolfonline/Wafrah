# Runtime PostgreSQL connection string.
# Local dev: standard postgresql:// URI.
# Vercel/Serverless production: use your provider's pooled connection URL (PgBouncer / Supavisor).
DATABASE_URL="postgresql://localhost:5432/wafrah_dev"

# Optional unpooled/direct PostgreSQL connection string used only during build-time
# `prisma migrate deploy` (recommended when DATABASE_URL is pooled on Neon/Supabase).
# DIRECT_URL="postgresql://user:password@direct-host:5432/wafrah?sslmode=require"

# Auth.js session signing secret (`openssl rand -base64 32`). Required in production.
AUTH_SECRET="replace-with-a-secure-random-secret"

# Canonical HTTPS origin used for cookies, email links, and Auth.js redirects in production.
# Set on Production ONLY — omit on Vercel Preview branches so each preview URL works cleanly.
APP_URL="http://localhost:3000"

# Set to "true" ONLY on Vercel Preview/Staging environments where Auth.js should trust the preview hostname.
# Do NOT enable globally without understanding proxy headers.
# AUTH_TRUST_HOST="true"

# Transactional email via Resend (alerts, weekly summaries, monthly reports).
RESEND_API_KEY="re_replace_with_api_key"
EMAIL_FROM="Wafrah <notifications@wafrah.sa>"

# Shared bearer secret sent automatically by Vercel Cron (`Authorization: Bearer <CRON_SECRET>`)
# and checked on /api/cron/* endpoints (`openssl rand -hex 32`).
CRON_SECRET="replace-with-cron-secret"

# Set to "1" only if a deploy build should skip `prisma migrate deploy` (e.g. read-only preview build).
# SKIP_MIGRATE_DEPLOY="0"

# Optional pilot support contact details rendered on /help
# SUPPORT_CONTACT_NAME="Wafrah Pilot Support"
# SUPPORT_CONTACT_EMAIL="support@your-domain.sa"
# SUPPORT_CONTACT_PHONE="+966 5X XXX XXXX"
# SUPPORT_WHATSAPP_URL="https://wa.me/9665XXXXXXXX"

# One-time CLI bootstrap variables for `pnpm db:seed:prod` (DO NOT commit real values; remove after seeding):
# SEED_ADMIN_EMAIL="admin@your-domain.sa"
# SEED_ADMIN_PASSWORD="replace-with-strong-unique-password"
# SEED_ADMIN_NAME="Wafrah Platform Admin"
# SEED_ADMIN_USERNAME="platform-admin"
# SEED_ADMIN_LOCALE="ar"

# Public Landing Page Contact & Canonical URL
NEXT_PUBLIC_WHATSAPP_NUMBER="966500000000"
FOUNDER_EMAIL="founder@wafrah.sa"
NEXT_PUBLIC_SITE_URL="https://wafrah.sa"
NEXT_PUBLIC_ANALYTICS_PROVIDER=""


