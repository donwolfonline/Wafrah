# Pooled runtime PostgreSQL connection URL (use local DB in dev; PgBouncer/Supavisor pooler with ?pgbouncer=true&connection_limit=1&sslmode=require in production).
DATABASE_URL="postgresql://localhost:5432/wafrah_dev"

# Direct unpooled PostgreSQL connection URL used only by Prisma CLI migrations (`pnpm db:migrate:deploy`, `prisma validate`) and `pnpm db:seed:prod`.
DIRECT_URL="postgresql://localhost:5432/wafrah_dev"

# Auth.js JWT signing secret (minimum 32 chars; generate with `openssl rand -base64 32`).
AUTH_SECRET="replace-with-a-secure-random-secret"

# Canonical HTTPS app origin used for server cookies, auth redirects, and report/alert links.
APP_URL="http://localhost:3000"

# Canonical public marketing origin used for SEO metadata, sitemaps, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://wafrah.sa"

# Optional fallback public app URL used when resolving origin links outside request headers.
# NEXT_PUBLIC_APP_URL="https://app.wafrah.sa"

# Optional legacy Auth.js canonical URL override (omit on Vercel Preview deployments).
# AUTH_URL="https://app.wafrah.sa"

# Set to "true" only on Vercel Preview/Staging so Auth.js trusts dynamic preview hostnames.
# AUTH_TRUST_HOST="true"

# Resend API key for transactional alerts, lead emails, and scheduled reports (required in production; omit on Vercel Preview for console email or use a test key).
RESEND_API_KEY="re_replace_with_api_key"

# Verified sender address for Resend transactional emails.
EMAIL_FROM="Wafrah <notifications@wafrah.sa>"

# Shared bearer secret protecting /api/cron/* endpoints (min 16 chars; generate with `openssl rand -hex 32`; NEVER set on Vercel Preview).
CRON_SECRET="replace-with-cron-secret"

# WhatsApp Business phone digits without "+" prefix for public CTAs and lead confirmation replies.
NEXT_PUBLIC_WHATSAPP_NUMBER="966500000000"

# Internal founder inbox receiving new pilot lead notifications from POST /api/leads.
FOUNDER_EMAIL="founder@wafrah.sa"

# Optional privacy-safe analytics provider key (leave empty until wired).
NEXT_PUBLIC_ANALYTICS_PROVIDER=""

# Legacy flag (ignored — Vercel builds never auto-run database migrations; run `pnpm db:migrate:deploy` deliberately before promotion).
# SKIP_MIGRATE_DEPLOY="1"

# Optional override build identifier baked into Next.js build output and /sw.js cache version.
# WAFRAH_BUILD_ID=""

# Optional custom Next.js build output directory for isolated local test builds.
# NEXT_DIST_DIR=".next"

# Optional pilot support contact name rendered on /help.
# SUPPORT_CONTACT_NAME="Wafrah Pilot Support"

# Optional pilot support email address rendered on /help.
# SUPPORT_CONTACT_EMAIL="support@your-domain.sa"

# Optional pilot support phone number rendered on /help.
# SUPPORT_CONTACT_PHONE="+966 5X XXX XXXX"

# Optional pilot support WhatsApp URL rendered on /help.
# SUPPORT_WHATSAPP_URL="https://wa.me/9665XXXXXXXX"

# One-time CLI Platform Admin email for `pnpm db:seed:prod` (`prisma/seed.production.ts`; never store in Vercel).
# ADMIN_EMAIL="admin@your-domain.sa"

# One-time CLI Platform Admin password (12+ mixed chars) for `pnpm db:seed:prod` (never store in Vercel).
# ADMIN_PASSWORD="replace-with-strong-unique-password"

# Optional initial Platform Admin display name for `pnpm db:seed:prod`.
# ADMIN_NAME="Wafrah Platform Admin"

# Optional initial Platform Admin username for `pnpm db:seed:prod`.
# ADMIN_USERNAME="platform-admin"

# Optional initial Platform Admin UI locale ("ar" or "en") for `pnpm db:seed:prod`.
# ADMIN_LOCALE="ar"

# Optional custom Chromium executable path used locally by `pnpm og:generate`.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# Optional directory overrides for Playwright visual/QA screenshot captures.
# LANDING_SCREENSHOT_DIR=""
# QA_SCREENSHOT_DIR=""
# ADMIN_SCREENSHOT_DIR=""
