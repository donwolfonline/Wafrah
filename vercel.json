{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "pnpm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "0 5 1 * *"
    }
  ]
}
