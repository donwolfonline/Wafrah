{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "15 0 * * 0"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "30 0 1 * *"
    }
  ]
}
