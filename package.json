{
  "name": "wafrah",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:prod": "tsx prisma/seed.production.ts",
    "db:reset": "prisma migrate reset",
    "vercel-build": "node scripts/vercel-build.mjs",
    "insights:run": "tsx scripts/run-insights.ts",
    "forecast:run": "tsx scripts/run-forecast.ts",
    "cron:daily": "tsx scripts/run-daily.ts",
    "og:generate": "tsx scripts/generate-og-images.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.8"
  }
}
